{
    "name": "goaop/framework",
    "description": "Framework for aspect-oriented programming in PHP.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "library",
        "aop",
        "php",
        "aspect"
    ],
    "authors": [
        {
            "name": "Lisachenko Alexander",
            "homepage": "https://github.com/lisachenko"
        }
    ],
    "homepage": "https://go.aopphp.com/",
    "require": {
        "php": "^8.4.0",
        "ext-tokenizer": "*",
        "goaop/dissect": "^4.0",
        "goaop/parser-reflection": "^4.0",
        "nikic/php-parser": "^5.0",
        "symfony/finder": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/orm": "^2.19 || ^3.0",
        "goaop/virtual-file-system": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "webmozart/glob": "^4.4"
    },
    "suggest": {
        "symfony/console": "Enables the usage of the command-line tool."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Go\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "Demo\\": "demos/"
        },
        "psr-4": {
            "Go\\": "tests/",
            "Go\\Tests\\TestProject\\": "tests/Fixtures/project/src/"
        },
        "files": [
            "tests/functions.php",
            "tests/Stubs/ClassWithoutNamespace.php",
            "tests/Proxy/Generator/Stubs/AttributeGroupsGeneratorStubs.php",
            "tests/Proxy/Generator/Stubs/FunctionGeneratorStubs.php",
            "tests/Proxy/Generator/Stubs/TypeGeneratorStubs.php",
            "tests/Proxy/Generator/Stubs/ParameterGeneratorStubs.php"
        ]
    },
    "bin": [
        "bin/aspect"
    ],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0-dev"
        }
    },
    "scripts": {
        "analyze": "phpstan analyze --memory-limit=512M",
        "check": [
            "@analyze",
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "analyze": "Run PHPStan static analysis (level 10)",
        "check": "Run static analysis and the test suite",
        "test": "Run the PHPUnit test suite"
    }
}
